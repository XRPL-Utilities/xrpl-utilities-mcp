# xrpl-utilities-mcp — example environment. Copy to .env (gitignored) and fill.
# All vars are optional; the server runs with sensible defaults.

# Transport + port
MCP_TRANSPORT=http          # "http" or "stdio" (default: stdio)
PORT=8080

# Operator-issued bypass for friendlies/demos (caller passes matching _bypass_key)
MCP_BYPASS_KEY=

# Startup validation toggles
MCP_SKIP_VALIDATE=0         # "1" to skip tool/schema validation on boot
MCP_FAIL_ON_DRIFT=0         # "1" to exit non-zero on schema drift
STRICT_VALIDATE=0           # "1" to treat an unreadable manifest as drift, not a warning.
                            # Off by default: Railway restarts ON_FAILURE, so failing
                            # closed would crash-loop the endpoint when a backend is cold.

# Rate-limit keying. Number of proxy hops in front of this container whose
# X-Forwarded-For entries we trust. Count them on the live deploy before
# changing: too high lets a caller spoof its own bucket key, too low would
# collapse every caller into one bucket (the limiter now walks left past
# private entries so a low count degrades instead, but that is a safety net,
# not a substitute for the real number).
TRUST_PROXY_HOPS=1

# H-Seal receipt co-signing (optional). Set BOTH to co-sign every tool
# response with a provider attestation (rides on the result's _meta.hSeal).
# Leave unset to disable. NEVER commit a real key — .env is gitignored.
PROVIDER_IDENTITY=          # our CAIP-10, e.g. xrpl:0:rXXXXXXXXXXXXXXXXXXXXXXXXXXXX
PROVIDER_KEY_RAW=           # 32-byte ed25519 seed (hex) for PROVIDER_IDENTITY

# Who this key will co-sign a 2-party receipt for. Comma-separated CAIP-10
# identities of the XR-* backends. Leave unset and any provider that can prove
# it holds the key for the identity it names is accepted — set it to pin the
# list so a compromised or spoofed backend cannot get the operator key to vouch
# for an arbitrary third party.
HSEAL_ALLOWED_PROVIDERS=    # e.g. xrpl:0:rAAA...,xrpl:0:rBBB...
