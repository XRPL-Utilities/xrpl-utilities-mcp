# xrpl-utilities-mcp — example environment. Copy to .env (gitignored) and fill.
# All vars are optional; the server runs with sensible defaults.

# Transport + port
MCP_TRANSPORT=http          # "http" or "stdio" (default: stdio)
PORT=8080

# Operator-issued bypass for friendlies/demos (caller passes matching _bypass_key)
MCP_BYPASS_KEY=

# Startup validation toggles
MCP_SKIP_VALIDATE=0         # "1" to skip tool/schema validation on boot
MCP_FAIL_ON_DRIFT=0         # "1" to exit non-zero on schema drift

# H-Seal receipt co-signing (optional). Set BOTH to co-sign every tool
# response with a provider attestation (rides on the result's _meta.hSeal).
# Leave unset to disable. NEVER commit a real key — .env is gitignored.
PROVIDER_IDENTITY=          # our CAIP-10, e.g. xrpl:0:rXXXXXXXXXXXXXXXXXXXXXXXXXXXX
PROVIDER_KEY_RAW=           # 32-byte ed25519 seed (hex) for PROVIDER_IDENTITY
