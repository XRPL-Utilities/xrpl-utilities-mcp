{
  "name": "@xrpl-utilities/mcp",
  "version": "0.2.124",
  "description": "Model Context Protocol server for XRPL-Utilities. 39 tools across 6 XRPL on-chain data services (Sentinel, Pulse, Telemetry, Trust, Vault, Flows). Stateless passthrough to x402-payable and free APIs. Hosted at mcp.xrpl-utilities.io.",
  "provider": "XRPL-Utilities LLC",
  "homepage": "https://xrpl-utilities.com",
  "repository": "https://github.com/XRPL-Utilities/xrpl-utilities-mcp",
  "npm": "https://www.npmjs.com/package/@xrpl-utilities/mcp",
  "registry": "https://registry.modelcontextprotocol.io/servers/io.github.XRPL-Utilities/mcp",
  "hosted_endpoint": "https://mcp.xrpl-utilities.io/mcp",
  "transport": [
    "stdio",
    "http+sse"
  ],
  "tool_count": 39,
  "tool_summary": {
    "free": 24,
    "paid": 15
  },
  "services": [
    {
      "id": "sentinel",
      "label": "XR-Sentinel",
      "url": "https://sentinel.xrpl-utilities.io",
      "manifest": "https://sentinel.xrpl-utilities.io/agents.json",
      "tools": 2
    },
    {
      "id": "pulse",
      "label": "XR-Pulse",
      "url": "https://pulse.xrpl-utilities.io",
      "manifest": "https://pulse.xrpl-utilities.io/agents.json",
      "tools": 14
    },
    {
      "id": "telemetry",
      "label": "XR-Telemetry",
      "url": "https://telemetry.xrpl-utilities.io",
      "manifest": "https://telemetry.xrpl-utilities.io/agents.json",
      "tools": 7
    },
    {
      "id": "trust",
      "label": "XR-Trust",
      "url": "https://trust.xrpl-utilities.io",
      "manifest": "https://trust.xrpl-utilities.io/agents.json",
      "tools": 9
    },
    {
      "id": "vault",
